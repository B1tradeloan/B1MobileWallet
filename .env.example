# Example environment variables for B1 Mobile Wallet

# Your MongoDB connection string (use your own from MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/b1wallet

# Session secret (used to encrypt login sessions)
SESSION_SECRET=super_secret_key_here

# Slot availability for each investment tier
SLOTS_JSON={"1000":23,"3000":10,"5000":7,"10000":4}

# Port (Render auto-assigns, only needed for local dev)
PORT=3000
